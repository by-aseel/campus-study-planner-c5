# Free-tier setup: create a key at https://console.groq.com/keys and paste locally.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Alternative: set LLM_PROVIDER=openrouter and use the settings below.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional. Relative paths are relative to the project root when using the host.
# STUDY_PLANNER_DB=data/tasks.sqlite3
